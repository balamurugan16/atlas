{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atlas",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "atlas",
      "database_id": "83207ed0-7895-43e4-b344-da6c9661a19d",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "eb4da41d39b04be7805e730b4701c876"
    }
  ],
  "vars": {
    "GITHUB_OWNER_ID": "64843585",
    "PUBLIC_URL": "https://atlas.balamurugand16.workers.dev",
    "GITHUB_CLIENT_ID": "Ov23ctD2jNxpKRRhEVcd"
  }
}
